{
  "name": "yada",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:wasm": "bash wasm/rust/build.sh",
    "build:js": "tsup",
    "build": "npm run build:wasm && npm run build:js && node scripts/copy-wasm.mjs",
    "test": "vitest run",
    "gate": "npm run build && npm run test && node scripts/check-size.mjs",
    "bench": "node bench/run.mjs"
  },
  "devDependencies": {
    "arquero": "^8.0.3",
    "danfojs": "^1.2.0",
    "fast-check": "^3.22.0",
    "tinybench": "^2.9.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
